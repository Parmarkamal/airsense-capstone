# ─────────────────────────────────────────────────────────────────────────────
# AirSense — Git Ignore Rules
# ─────────────────────────────────────────────────────────────────────────────

# CRITICAL: Prevent large binary zip files from breaking GitHub (100MB limit)
*.zip
*.tar
*.tar.gz
*.rar
Air-Sense-Master.zip

# CRITICAL: Secrets and environment credentials (NEVER commit tokens)
.env
*.env
.env.local
.env.*.local

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing and coverage caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Vector database local storage (large binaries)
airsense/data/chroma_db/
data/chroma_db/

# MLflow temporary artifacts and staging models
airsense/ml/staging/*.pkl
ml/staging/*.pkl

# OS temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and editor settings (keep repo clean)
.idea/
.vscode/
*.swp
*.swo
*~


kafkazookeeper-data/
airsense/logs/*.json
airsense/logs/*.log
