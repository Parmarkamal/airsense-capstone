# ─────────────────────────────────────────────────────────────────────────────
# AirSense — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# WAQI live data (required Week 1)
WAQI_TOKEN=your_waqi_token_here

# Kafka (ZooKeeper mode — localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=aqi_raw

# TimescaleDB (required Week 2)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airsense_db
POSTGRES_USER=airsense
POSTGRES_PASSWORD=change_me_locally

# Ollama (Week 8)
OLLAMA_MODEL=phi3:mini
OLLAMA_HOST=http://localhost:11434

# Telegram alerts (Week 11)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MLflow
MLFLOW_TRACKING_URI=./ml/mlruns
